type: missile
name: SM-3 迎撃弾頭

// 自作のスプライト画像を適用
sprite: sm3-missile

// 敵の通常タレットや通常弾で撃ち落とされるための設定
health: 150
isEnemy: false
allowedInPayloads: false
playerControllable: false
logicControllable: false
targetable: true
hittable: true

// 移動性能
speed: 12
accel: 0.15
rotateSpeed: 20

// 迎撃ミサイルの白い煙
trailColor: ffffff
trailLength: 25

// 飛翔音
loopSound: torch
loopSoundVolume: 0.6

// 爆発・ダメージ
hitSound: explosion
deathExplosionEffect: blastExplosion

weapons: [
  {
    type: Weapon
    shootOnDeath: true
    reload: 10
    bullet: {
      type: BulletType
      instantDisappear: true
      damage: 180
      splashDamage: 100
      splashDamageRadius: 30
      killShooter: true
      
      collidesAir: true
      collidesGround: true
    }
  }
]
