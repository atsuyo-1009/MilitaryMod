type: ItemTurret
name: プロトテックレールガン
description: '''プロトテックレールガン。高威力の火力を提供します。最終兵器としてどうぞ。'''
size: 3
health: 1200
range: 800

// 発射速度（数値が大きいほど次の発射までが長い）
reload: 240

// チャージ時間（60 = 1秒）
chargeTime: 60
// チャージ中に鳴る音
chargeSound: lancerLaserCharge
// 発射時に鳴る音
shootSound: railShoot
hasPower: true       // 電源ネットワークに接続できるようにする
consumes: {
  power: 3.5
}
shoot: {
  // チャージ時間（chargeTime）と同じ音声を同期させるための遅延設定
  firstShotDelay: 60
}

// 📌 使用するアイテム（弾薬）ごとの設定
ammoTypes: {
  tarretAmmo: {
    type: RailBulletType // レールガンに最適な即時着弾タイプの弾
    damage: 250
    speed:50
	  lifetime:16
    trailEffect: railTrail
    ammoMultiplier: 1
pierceArmor: true
 scaledSplashDamage:true
    splashDamage: 700
    splashDamageRadius: 60
       pierce: true
      pierceBuilding: true
      pierceCap:10
hitEffect:[
          {
    hitEffect: railHit
    smokeSize:200
    sparks:1300
    smokes:100
            }
            ]
  }
  mod-copper: {
    type: RailBulletType
    damage: 400
    length: 290
    speed:50
	  lifetime:16
    // 敵を貫通する数
    pierceCap: 5
    chargeEffect: greenLaserCharge
    trailEffect: instTrail
    hitEffect: instHit
    ammoMultiplier: 1
pierceArmor: true
 scaledSplashDamage:true
    splashDamage: 700
    splashDamageRadius: 60
       pierce: true
      pierceBuilding: true
      pierceCap:10
 // 📌 弾道をきれいに表示させるための設定
    line: true            // 弾道を線として描画する
    strokeSrc: 4          // 線の太さ（発射口側）
    strokeDst: 0          // 線の太さ（着弾点側。0にすると先端に向かって細くなります）
    colorSrc: 7ba9ff      // 弾道の色（発射口側：綺麗な青）
    colorDst: c7e7ff      // 弾道の色（着弾点側：薄い青）
    
    // 📌 弾道にそって残るエフェクト（火花や煙）
    trailEffect: railTrail 
    trailLength: 30       // エフェクトが残る長さ
    trailWidth: 3         // エフェクトの太さ
hitEffect:[
          {
    hitEffect: railHit
    smokeSize:200
    sparks:1300
    smokes:100
 // 📌 弾道をきれいに表示させるための設定
    line: true            // 弾道を線として描画する
    strokeSrc: 4          // 線の太さ（発射口側）
    strokeDst: 0          // 線の太さ（着弾点側。0にすると先端に向かって細くなります）
    colorSrc: 7ba9ff      // 弾道の色（発射口側：綺麗な青）
    colorDst: c7e7ff      // 弾道の色（着弾点側：薄い青）
    
    // 📌 弾道にそって残るエフェクト（火花や煙）
    trailEffect: railTrail
    trailLength: 30       // エフェクトが残る長さ
    trailWidth: 3         // エフェクトの太さ
            }
            ]
  }

}

// 建築コスト
requirements: [
  copper/150
  lead/100
  silicon/80
]
category: turret
