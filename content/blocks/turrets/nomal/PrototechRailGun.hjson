type: ItemTurret
name: プロトテックレールガン
description: '''プロトテックレールガン。高威力の火力を提供します。最終兵器としてどうぞ。'''
size: 3
health: 1200
range: 800

// 発射速度（数値が大きいほど次の発射までが長い）
reload: 240

// チャージ時間（60 = 1秒）
chargeTime: 60
// チャージ中に鳴る音
chargeSound: lancerLaserCharge
// 発射時に鳴る音
shootSound: railShoot

shoot: {
  // チャージ時間（chargeTime）と同じ音声を同期させるための遅延設定
  firstShotDelay: 60
}

// 📌 使用するアイテム（弾薬）ごとの設定
ammoTypes: {
  tarretAmmo: {
    type: RailBulletType // レールガンに最適な即時着弾タイプの弾
    damage: 250
    speed:50
	  lifetime:16
    // 発射口にエネルギーが集まるエフェクト
    chargeEffect: lancerLaserCharge
    // 弾道（軌跡）のエフェクト
    trailEffect: railTrail
    ammoMultiplier: 1
  }
  mod-copper: {
    type: RailBulletType
    damage: 400
    length: 290
    speed:50
	  lifetime:16
    // 敵を貫通する数
    pierceCap: 5
    chargeEffect: greenLaserCharge
    trailEffect: instTrail
    hitEffect: instHit
    ammoMultiplier: 1
  }
       pierceArmor: true
 scaledSplashDamage:true
    splashDamage: 700
    splashDamageRadius: 60
       pierce: true
      pierceBuilding: true
      pierceCap:10
hitEffect:[
          {
    hitEffect: railHit
    smokeSize:200
    sparks:1300
    smokes:100
            }
            ]

}

// 建築コスト
requirements: [
  copper/150
  lead/100
  silicon/80
]
category: turret
