}

 reload: 60
ammoTypes: {
  tarretAmmo: {
    type:MissileBulletType
	inaccuracy: 0.5
	  damage:1050
	  speed:10
	  lifetime:50
	  width:5
	  height:10
	  ammoMultiplier:1
      sprite: aiueo-SeaRAM
  }
}
requirements: [
  copper/120
  titanium/80
  silicon/100
]
category: turret
