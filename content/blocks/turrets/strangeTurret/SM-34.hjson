type: ItemTurret
name: SM-3 VLSサイロ
description: '''艦載式の垂直発射システム（VLS）。敵の航空・地上目標に向けて、2発ずつの迎撃ミサイルを時間差で連続垂直発射します。'''
size: 3
health: 1500
range: 550 // 超長射程

// 📌 砲塔は完全に正面（0度）で固定する
rotateSpeed: 0

// 📌 砲塔の向きに関係なく、360度どこに敵がいても「ロックオン完了」とみなして即発射する
shootCone: 360

targetInterval: 1

shoot: {
  type: ShootSequence
  shots: 2        // 計4発を連続で垂直発射
  shotDelay: 60   // 弾と弾の間の発射ディレイ（約0.25秒）
}

// ミサイルが完全に重なって飛ばないよう、わずかなブレを設定
inaccuracy: 3

reload: 240 // 次の斉射（計4発）までの装填時間

// 🔊 【修正】バニラに確実に存在するミサイル発射音に変更
shootSound: missile

// 💨 発射時にVLS特有の大量の白い煙を発生させる
shootEffect: shootSmokeMissile

consumes: {
  power: 2.0
}

ammoTypes: {
  surge-alloy: {
    type: MissileBulletType
    damage: 180
    speed: 1.5       // 最初は遅く飛び出す（垂直上昇の演出）
    lifetime: 300    // 長距離飛ぶための寿命
    
    // 🖼️ 自作のスプライト画像を適用
    sprite: sm3-missile
    
    width: 6
    height: 18
    shrinkY: 0
    
    // 🛡️ ミサイルを迎撃（敵の攻撃で破壊）可能にする設定
    killable: true
    health: 50       // ミサイル自身のHP
    
    // 超高速誘導の設定
    homingPower: 0.35    // 高い誘導性能（急カーブで追尾）
    homingRange: 450     // 広い索敵範囲
    homingDelay: 20      // 最初の20フレームは直進して垂直上昇を表現
    accel: 0.15          // 発射後、徐々に猛加速する
    maxVelocity: 12      // 最終的な最高速度（最速クラス）
    
    // 迎撃ミサイルの白い煙を再現
    trailColor: ffffff
    trailLength: 25
    trailWidth: 3
    backColor: d1efff
    frontColor: ffffff
    
    // 🔊 【修正】飛翔音（弾が消えるまで鳴り続けるループ音）
    // バニラの持続音「torch」（ゴーという火炎・推進音）を指定
    chargeSound: torch
    soundPitchMin: 1.0
    soundPitchMax: 1.2
    
    // 🔊 【修正】着弾・爆発時の音
    hitSound: explosion
    
    splashDamage: 100
    splashDamageRadius: 30
    
    collidesAir: true
    collidesGround: true
  }
}

requirements: [
  titanium/250
  thorium/150
  silicon/200
  surge-alloy/50
]
category: turret
