type: ItemTurret
name: SM-3 VLSサイロ
description: '''艦載式の垂直発射システム（VLS）。敵の航空・地上目標に向けて、2発ずつの迎撃ミサイルを時間差で連続垂直発射します。'''
size: 3
health: 1500
range: 1500 // 超長射程

rotateSpeed: 0
shootCone: 360
targetInterval: 1

shoot: {
  type: ShootSequence
  shots: 2        // 計4発を連続で垂直発射
  shotDelay: 60   // 弾と弾の間の発射ディレイ（約0.25秒）
}

inaccuracy: 3
reload: 240 // 次の斉射（計4発）までの装填時間

shootSound: missile
shootEffect: shootSmokeMissile

consumes: {
  power: 2.0
}

ammoTypes: {
  surge-alloy: {
    // ⚙️ 敵タレットから「自動ロックオン」され、敵ユニットへ飛ぶ飛行型を召喚
    type: BulletType
    spawnUnit: SM--3
    
    speed: 1.5
    lifetime: 300
    
    shootEffect: none
    smokeEffect: none
  }
}

requirements: [
  titanium/250
  thorium/150
  silicon/200
  surge-alloy/50
]
category: turret
