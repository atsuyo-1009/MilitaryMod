type: ItemTurret
name: SM-3 VLSサイロ8
description:
  '''
  艦載式の垂直発射システム（VLS）。
  敵の航空・地上目標に向けて、2発の迎撃ミサイルを時間差で連続垂直発射します。
  '''
size: 3
health: 1500
range: 1000

# 📌 旋回せず、全方向に即座に発射できるように固定
rotateSpeed: 0
shootCone: 360

shoot: {
  type: ShootSequence
  shots: 2        # 説明文の「2発ずつ」に合わせました（4発にするならここを4に）
  shotDelay: 60   # 弾と弾の間のディレイ（Mindustryの15フレーム＝0.25秒）
}

inaccuracy: 3
reload: 240
predictTarget: false
shootSound: missile
shootEffect: shootSmokeMissile

# 📌 消費電力は「consumes」ではなく「consume」オブジェクト内に記述（V7仕様）
consume: {
  power: 2.0
}

ammoTypes: {
tarretAmmo: {
    ammoMultiplier: 12
    reloadMultiplier: 0.75
    shootEffect: shootBig
    smokeEffect: shootBigSmoke
    instantDisappear: true
    damage: 0
    spawnUnit: SM-4
  }
}

requirements: [
  titanium/250
  thorium/150
  silicon/200
  surge-alloy/50
]
category: turret
