type: ItemTurret
name: SM-3 VLSサイロ
description: '''艦載式の垂直発射システム（VLS）。敵の航空・地上目標に向けて、2発ずつの迎撃ミサイルを時間差で連続垂直発射します。'''
size: 3
health: 1500
range: 550 // 超長射程

rotateSpeed: 0
shootCone: 360
targetInterval: 1

shoot: {
  type: ShootSequence
  shots: 2        // 計4発を連続で垂直発射
  shotDelay: 60   // 弾と弾の間の発射ディレイ（約0.25秒）
}

inaccuracy: 3
reload: 240 // 次の斉射（計4発）までの装填時間

shootSound: missile
shootEffect: shootSmokeMissile

consumes: {
  power: 2.0
}

ammoTypes: {
  surge-alloy: {
    // ⚙️ 通常の弾薬で撃ち落とせるようにするため、空中ミサイルユニットを召喚する弾薬に変更
    type: BulletType
    spawnUnit: SM--3 
// 📌 下記で定義する空中ミサイルユニット
    
    // 砲塔から飛び出す際の初期スラスト（垂直上昇の演出）
    speed: 1.5
    lifetime: 300
    
    shootEffect: none
    smokeEffect: none
  }
}

requirements: [
  titanium/250
  thorium/150
  silicon/200
  surge-alloy/50
]
category: turret
