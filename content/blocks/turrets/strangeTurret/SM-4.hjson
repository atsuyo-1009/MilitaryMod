type: ItemTurret
name: SM-3 VLSサイロ
description:
  '''
  艦載式の垂直発射システム（VLS）。
  敵の航空・地上目標に向けて、2発の迎撃ミサイルを時間差で連続垂直発射します。
  '''
size: 3
health: 1500
range: 1500

# 📌 旋回せず、全方向に即座に発射できるように固定
rotateSpeed: 0
shootCone: 360

shoot: {
  type: ShootSequence
  shots: 2        # 説明文の「2発ずつ」に合わせました（4発にするならここを4に）
  shotDelay: 60   # 弾と弾の間のディレイ（Mindustryの15フレーム＝0.25秒）
}

inaccuracy: 3
reload: 240

shootSound: missile
shootEffect: shootSmokeMissile

# 📌 消費電力は「consumes」ではなく「consume」オブジェクト内に記述（V7仕様）
consume: {
  power: 2.0
}

ammoTypes: {
  surge-alloy: {
    # 📌 ユニットを生成するため「SpawnBulletType」に変更
    type: SpawnBulletType
    
    # 📌 ハイフンが2つになっていた名称エラーを修正
    spawnUnit: SM-3
    
    # 📌 VLS（垂直発射）を再現。最初は上（前）に低速で飛び出し、その後ミサイル自身のAIで敵へ向かわせる
    speed: 3
    lifetime: 30
    
    # 弾頭の見た目は透明にして、召喚されるミサイルユニット本体だけが見えるようにする
    layer: 0
    drawSize: 0
    damage: 0
    shootEffect: none
    smokeEffect: none
  }
}

requirements: [
  titanium/250
  thorium/150
  silicon/200
  surge-alloy/50
]
category: turret
