name:太陽光発電機
type:SolarGenerator
description:
'''これは太陽光発電です。ほぼすべての場所で非常用に使うことができます。
'''

//施設のサイズ
size: 1

//このブロックを構築するためのコスト。
requirements: [
		IronIngot/10
	]
//どこのカテゴリに配置するか　電気、ドリル、壁、etc、、、
category: power

//研究をするか否か　trueでアンロック
//alwaysUnlocked:false

//テックツリーのどこにぶら下げるか
category: power
research:{
planet: Earth
parent:IronPowerNode
name: MilitaryMod
requiments:[
IronIngot: 100
           ]
        }
//体力
health: 50

//発電量 0.1で1倍で発電
//発電量6のソーラーパネルの場合120発電
//ソーラー専用？
powerProduction: 1.15

//trueの場合、建物にはPowerModuleがあります。
//hasPower: true
//outputsPower: true
//consumesPower: true

//trueの場合、建物にはItemModuleがあります。
//hasItems: false

//trueの場合、建物にはLiquidModuleがあります。
//hasLiquids: false

//作成時間?
craftTime: 60

//破壊可能か
//destructible: true

//ドリル中にランダムに再生される効果。
//updateEffect: smeltsmoke

